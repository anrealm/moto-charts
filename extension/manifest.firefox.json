{
  "manifest_version": 3,
  "name": "moto-charts",
  "version": "1.3.0",
  "description": "Ride a motorbike over any SVG chart line — a physics trials game played on your own data.",
  "author": "anrealm",
  "browser_specific_settings": {
    "gecko": {
      "id": "moto-charts@anrealm",
      "update_url": "https://anrealm.github.io/moto-charts/updates.json",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "moto-charts",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "scripts": [
      "launcher.js",
      "background.js"
    ]
  },
  "commands": {
    "start-ride": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Ride the chart"
    }
  }
}
