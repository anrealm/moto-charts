{
  "manifest_version": 3,
  "name": "moto-charts",
  "version": "1.0.0",
  "description": "Ride a motorbike over any chart line on the page, Gravity Defied style.",
  "author": "anrealm",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "moto-charts",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "start-ride": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Ride the chart"
    }
  }
}
